          "fontSize": 17,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "V2fUi7",
          "name": "Cap Body",
          "fill": "#9AA2AE",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "直近の1件だけ案Cに近い全幅ボタン（40px）+「次」バッジで強調し、残りは案Gの小ピルに落とす。最優先の行動が一目で決まりつつ、リスト全体は静かなまま。優先順位のロジックが外れると逆に迷わせる。",
          "lineHeight": 1.65,
          "fontFamily": "Noto Sans JP",
          "fontSize": 13,
